# Защита бэкенда. Лежит в public_html/api/.htaccess.
# .php-файлы выполняются как обычно; закрываем только секреты и локальную БД.

# Передаём Bearer-заголовок в PHP/FastCGI для закрытого API личного GPT.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

# Секреты прода — наружу никогда.
<FilesMatch "(?i)^secrets.*\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Файлы локальной БД (SQLite) и любые дампы — наружу никогда.
<FilesMatch "(?i)\.(sqlite|sqlite3|db|sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Папку data/ (sqlite, временные файлы) закрываем целиком.
RedirectMatch 404 (?i)^/api/data/

# Не раздавать листинг каталога.
Options -Indexes
